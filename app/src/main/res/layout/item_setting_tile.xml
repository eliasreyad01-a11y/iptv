<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="76dp" android:layout_margin="5dp" android:background="@drawable/bg_tile"
    android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
    <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center"
        android:maxLines="2" android:textColor="@color/white" android:textSize="15sp" />
    <TextView android:id="@+id/tvValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center"
        android:maxLines="1" android:textColor="#FFD0D0" android:textSize="13sp" />
</LinearLayout>
